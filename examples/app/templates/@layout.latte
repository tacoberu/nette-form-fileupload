<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta n:ifset="$robots" name="robots" content="{$robots}" />
	<meta name="viewport" content="width=device-width" />

	<title>{block title|striptags|trim}{/block} | Nette example</title>

	<link rel="stylesheet" media="screen" href="{$basePath}/css/filecontrol.css" />
	<link rel="stylesheet" media="screen" href="{$basePath}/css/site.css" />
</head>

<body>
	<div n:foreach="$flashes as $flash" class="flash {$flash->type}">{$flash->message}</div>

	<div id="content" class="container">
		{include content}
	</div>

	<script src="https://code.jquery.com/jquery-3.7.1.js"></script>
	<script src="{$basePath}/js/netteForms.min.js"></script>
	<script src="{$basePath}/js/netteAjax.js"></script>
	<script type="module">
		import { initMultiFileAutoPreload, initFileHideOnNew, initFileClearButton } from '/js/filecontrol.js';
		document.querySelectorAll('[data-taco-type="file multiple"]')
			.forEach(initMultiFileAutoPreload);
		document.querySelectorAll('.taco-filecontrol-single')
			.forEach(initFileHideOnNew);
		document.querySelectorAll('.taco-filecontrol-single input[type="file"]')
			.forEach(initFileClearButton);
	</script>
	<script type="text/javascript">
		$(function() {
			$(function () {
				$.nette.init();
			});
		});
	</script>
</body>
</html>
