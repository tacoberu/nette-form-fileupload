<?xml version="1.0" encoding="UTF-8"?>
<phpunit backupGlobals="false" colors="true" processIsolation="false" stopOnFailure="false" failOnWarning="true" bootstrap="vendor/autoload.php">
  <testsuites>
    <testsuite name="PHPUnit DOM Assertions Test Suite">
      <directory suffix="Test.php">./tests</directory>
    </testsuite>
  </testsuites>
</phpunit>
