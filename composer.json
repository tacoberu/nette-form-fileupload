{
	"name": "tacoberu/nette-form-fileupload",
	"description": "Uploading files has its specifics. It is not enough just to upload the file. We also want to show it when it's already uploaded (preferably with a preview). We want to possibly delete it or replace it with another version.",
	"type": "library",
	"license": "MIT",
	"keywords": [
		"nette",
		"form",
		"file",
		"fileupload"
	],
	"require": {
		"php" : ">=7.4",
		"nette/forms": "^3.1"
	},
	"require-dev": {
		"phpstan/phpstan": "^1.10",
		"phpunit/phpunit": "^9.6",
		"slevomat/coding-standard": "^8.29",
		"rector/rector": "^1.0",
		"nette/application": "^3.1",
		"nette/di": "^3.1",
		"nette/bootstrap": "^3.1",
		"tracy/tracy": "^2.9",
		"latte/latte": "^2.11"
	},
	"autoload": {
		"classmap": ["libs"]
	},
	"scripts": {
		"phpstan": "phpstan analyse",
		"phpunit": "vendor/bin/phpunit",
		"phpcs": "vendor/bin/phpcs",
		"phpcbf": "vendor/bin/phpcbf",
		"rector": "vendor/bin/rector process --dry-run"
	},
    "config": {
        "platform": {
            "php": "7.4"
        },
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
